{
	"name": "oliverthiele/ot-flippingbook",
	"type": "typo3-cms-extension",
	"description": "CE FlippingBooks - TYPO3 content element for the integration of documents created with the FlippingBook Publisher (https://flippingbook.com/digital-publishing-software)",
	"homepage": "https://www.oliver-thiele.de/",
	"authors": [
		{
			"name": "Oliver Thiele",
			"email": "mail@oliver-thiele.de",
			"role": "Developer",
			"homepage": "https://www.oliver-thiele.de/"
		}
	],
	"license": [
		"GPL-2.0-or-later"
	],
	"keywords": [
		"typo3",
		"flippingbook",
		"content element",
		"embed",
		"catalog"
	],
	"require": {
		"php": ">=8.2",
		"typo3/cms-core": "^13.4||^14.3"
	},
	"require-dev": {
		"phpstan/phpstan": "^2.1",
		"saschaegerer/phpstan-typo3": "^3.0",
		"roave/security-advisories": "dev-latest"
	},
	"autoload": {
		"psr-4": {
			"OliverThiele\\OtFlippingbook\\": "Classes/"
		}
	},
	"extra": {
		"typo3/cms": {
			"extension-key": "ot_flippingbook"
		}
	},
	"support": {
		"issues": "https://github.com/oliverthiele/ot-flippingbook/issues",
		"source": "https://github.com/oliverthiele/ot-flippingbook"
	}
}
